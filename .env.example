# Google OAuth 2.0 Web Client Credentials
# Configure in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173, https://<your-vercel-domain>.vercel.app
# Authorized redirect URIs: http://localhost:5173, https://<your-vercel-domain>.vercel.app

# Client ID (Public / frontend safe)
VITE_GOOGLE_CLIENT_ID=

# Client Secret (Serverless only — keep strictly secret in .env or Vercel Environment Variables)
GOOGLE_CLIENT_SECRET=
